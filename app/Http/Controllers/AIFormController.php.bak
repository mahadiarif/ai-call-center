    public function processAudioData(\Illuminate\Http\Request $request)
    {
        // ... (আপনার আগের অডিও ফাংশনগুলো এখানে থাকবে, সেগুলো বদলাতে হবে না) ...
    }

    // 🚀 শুধু টেক্সট প্রসেস করে ডাটাবেস বানানোর ফাংশন (Smart JSON Cleaner সহ ফিক্সড)
    public function processFinalText(\Illuminate\Http\Request $request)
    {
        try {
            $transcript = $request->text;
            $token = $this->getGoogleToken(); 
            $projectId = 'ai-calls-center'; 

            $ivrKey = $request->input('ivr_key', '1'); 
            $service = \App\Models\IvrService::where('key_press', $ivrKey)->where('is_active', true)->first();
            if (!$service) {
                $service = \App\Models\IvrService::where('is_active', true)->first();
            }

            if (!$token || empty($transcript)) {
                return response()->json(['status' => 'error', 'message' => 'কোনো টেক্সট পাওয়া যায়নি।']);
            }

            // 🚀 এআইকে কী কী ফিল্ড এক্সট্র্যাক্ট করতে হবে তার লিস্ট
            $expectedKeysArray = ['customer_name', 'mobile_number', 'address', 'product_name', 'problem_description'];
            if ($service && $service->required_fields) {
                foreach ($service->required_fields as $field) {
                    $expectedKeysArray[] = $field['field_name']; 
                }
            }
            $expectedKeysString = implode(', ', $expectedKeysArray);

            $url = "https://us-central1-aiplatform.googleapis.com/v1beta1/projects/{$projectId}/locations/us-central1/publishers/google/models/gemini-2.5-flash:generateContent";
            $prompt = "🎯 কাস্টমার থেকে ডাটা বের করার এক্সট্রিম স্ট্রিক্ট নিয়ম:\n\n📞 কাস্টমার কি বলেছেন:\n\"{$transcript}\"\n\n⛔ সবচেয়ে গুরুত্বপূর্ণ নিয়ম (ZERO TOLERANCE):\n1️⃣ এই ট্র‍্যান্সক্রিপ্টে যা যা আছে, শুধুই অন্তর্ভুক্ত করো। একটি শব্দও অতিরিক্ত যোগ করবে না।\n2️⃣ যা কথায় নেই তা কল্পনা করবে না। কোনো অনুমান নেই, কোনো ম্যাচিং নেই।\n3️⃣ কোনো 'N/A', কোনো ডিফল্ট মূল্য, কোনো placeholder নেই। যা বলা হয়েছে শুধু সেটা।\n4️⃣ যদি কিছু না বলা হয় = একেবারে স্কিপ করো (JSON এ সেই key-value দিবে না)।\n5️⃣ বাংলাদেশী নাম এবং উচ্চারণ সম্মান করো - ঠিক যেভাবে কথায় এসেছে।\n\n✅ এক্সট্র্যাক্ট করার ফিল্ড:\n{$expectedKeysString}\n\n📋 সঠিক উদাহরণ:\n- কাস্টমার: 'আমার নাম কাবির'\n  ✔️ JSON: {\"customer_name\":\"কাবির\"}\n- কাস্টমার: 'আমি ঢাকায় আছি, সমস্যা হয়েছে'\n  ✔️ JSON: {\"address\":\"ঢাকা\",\"problem_description\":\"সমস্যা হয়েছে\"}\n- কাস্টমার: 'হ্যালো'\n  ✔️ JSON: {} (কিছু বলেনি, একেবারে খালি)\n\n🚨 ভুল যা কখনো করবে না:\n❌ গেস করা: 'আমার নাম কাবির' → নাম লেখে "মোহাম্মদ কাবির"\n❌ ডিফল্ট মূল্য: "N/A", "Unknown", "Not Provided" - এগুলো নয়\n❌ অতিরিক্ত field: কাস্টমার শুধু নাম বলেছে, তারপর district বা product যোগ করবে না\n\n📤 JSON Response ONLY:\nশুধুমাত্র valid JSON, অন্য কোনো টেক্সট নয়। কোনো মার্কডাউন (```json), কোনো ব্যাখ্যা।";



            $response = \Illuminate\Support\Facades\Http::withToken($token)
                ->post($url, [
                    'contents' => [['role' => 'user', 'parts' => [['text' => $prompt]]]],
                    'generationConfig' => ['responseMimeType' => 'application/json']
                ]);

            if ($response->successful()) {
                $content = $response->json('candidates.0.content.parts.0.text');
                
                // 🚀 ম্যাজিক ফিক্স: জেমিনি মার্কডাউন (```json) দিলে সেটা পরিষ্কার করা
                $cleanContent = str_replace(['```json', '```'], '', $content);
                $cleanContent = trim($cleanContent);
                
                // যদি JSON না হয় তাহলে এরর
                if (empty($cleanContent) || !is_string($cleanContent)) {
                    throw new \Exception('Empty response from AI');
                }
                
                $data = json_decode($cleanContent, true);

                if (json_last_error() !== JSON_ERROR_NONE) {
                    throw new \Exception('JSON Decode Error: ' . json_last_error_msg());
                }
                
                // ✅ JSON validation - সব ফিল্ড string হতে হবে, না হলে N/A রাখো
                if (is_array($data)) {
                    foreach ($data as $key => &$value) {
                        // যদি array বা object হয়, তাহলে এটা জেনারেটেড ডাটা
                        if (is_array($value) || is_object($value)) {
                            $value = 'N/A';
                        }
                        // convert to string
                        $value = (string)$value;
                        // এখনও 'N/A' থাকলে তাহলে skipp করো
                        if ($value === 'N/A' || empty(trim($value))) {
                            unset($data[$key]);
                        }
                    }
                }

                $ticket = new \App\Models\ServiceRequest();
                
                $ticket->ivr_service_id = $service ? $service->id : null; 
                $ticket->extracted_data = $data; 
                
                // ✅ শুধুমাত্র প্রকৃত ডাটা স্টোর করো - N/A কোথাও থাকবে না
                $ticket->customer_name = !empty($data['customer_name']) ? trim($data['customer_name']) : null;
                $ticket->mobile_number = !empty($data['mobile_number']) ? trim($data['mobile_number']) : null;
                $ticket->alt_mobile_number = !empty($data['alt_mobile_number']) ? trim($data['alt_mobile_number']) : null;
                $ticket->address = !empty($data['address']) ? trim($data['address']) : null;
                $ticket->district = !empty($data['district']) ? trim($data['district']) : null;
                $ticket->product_name = !empty($data['product_name']) ? trim($data['product_name']) : null;
                $ticket->barcode = !empty($data['barcode']) ? trim($data['barcode']) : null;
                $ticket->problem_description = !empty($data['problem_description']) ? trim($data['problem_description']) : null;
                $ticket->call_transcript = $transcript; 
                $ticket->status = 'Pending';
                
                $ticket->save();

                return response()->json(['status' => 'success']);
            }

            return response()->json(['status' => 'error', 'message' => 'Google API Error: ' . $response->body()]);
        } catch (\Exception $e) {
            \Illuminate\Support\Facades\Log::error("Text Save Error: " . $e->getMessage());
            return response()->json(['status' => 'error', 'message' => 'সার্ভার এরর: ' . $e->getMessage()]);
        }
    }
}